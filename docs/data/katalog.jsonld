   "@type": "dcat:Dataset",
   "dct:identifier": "deszczowa-gus",
   "dct:title": {
    "@language": "pl",
    "@value": "Kanalizacja deszczowa i interwencje przy opadach"
   },
   "dct:description": {
    "@language": "pl",
    "@value": "Kilometry kanalizacji deszczowej oddanej do użytku w roku i nakłady na nią (powiaty) oraz interwencje straży pożarnej przy opadach deszczu i przyborach wód (gminy). GUS nie publikuje łącznej długości sieci deszczowej w gminach, a dane o nowo oddanej sieci w gminach kończą się na 2008 r., dlatego pokazano powiaty."
   },
   "dcat:theme": "Środowisko",
   "dct:temporal": "2010–2025 (kanalizacja), 2018–2025 (interwencje)",
   "dct:accrualPeriodicity": "co rok",
