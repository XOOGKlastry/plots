  {
   "@id": "https://xoogklastry.github.io/plots/katalog.html#wody-2apgw",
   "@type": "dcat:Dataset",
   "dct:identifier": "wody-2apgw",
   "dct:title": {
    "@language": "pl",
    "@value": "Stan wód, zlewnie i administracja wodna"
   },
   "dct:description": {
    "@language": "pl",
    "@value": "Zlewnie jednolitych części wód powierzchniowych z oceną stanu (ogólny, ekologiczny, chemiczny), ryzykiem nieosiągnięcia celów, odstępstwami i presjami; rzeki JCWP; wody podziemne (JCWPd) ze stanem i ryzykiem; granice nadzorów wodnych, zarządów zlewni i RZGW; obszary chronione zależne od wód. Wskaźniki gmin: udział powierzchni w zlewniach o złym stanie, zagrożonych, z presją wód opadowych, rolniczą, komunalną, hydromorfologiczną i ilościową, nad wodami podziemnymi w słabym stanie, udział obszarów chronionych i gęstość rzek. Udziały liczone ze zlewni JCWP rzecznych i przejściowych przeciętych granicą gminy. Udziały stanu odnoszą się tylko do ocenionej części powierzchni. Geometrie na mapie są uproszczone."
   },
   "dcat:theme": "Środowisko",
   "dct:temporal": "plany 2022–2027 (ocena stanu z lat 2014–2019)",
   "dct:accrualPeriodicity": "przy aktualizacji planów (co 6 lat)",
   "dct:modified": {
    "@type": "xsd:date",
    "@value": "2026-11-20"
   },
   "dct:source": [
    {
     "@id": "https://apgw.gov.pl/",
     "dct:title": "Wody Polskie, plany gospodarowania wodami (2aPGW), Geobaza wersja 15.09.2023"
    },
    {
     "@id": "https://www.gov.pl/web/wody-polskie",
     "dct:title": "Wody Polskie, granice RZGW, zarządów zlewni i nadzorów wodnych (wersja 1.08)"
    }
   ],
