  {
   "@id": "https://xoogklastry.github.io/plots/katalog.html#egib-uzytki",
   "@type": "dcat:Dataset",
   "dct:identifier": "egib-uzytki",
   "dct:title": {
    "@language": "pl",
    "@value": "Użytkowanie gruntów w gminach"
   },
   "dct:description": {
    "@language": "pl",
    "@value": "Użytki rolne, lasy, wody i grunty zabudowane: szacunek z ewidencji gruntów (oznaczenia użytków działek, 513 gmin z pełnym pokryciem), pokrycie terenu z BDOT10k dla wszystkich gmin oraz użytki rolne w gospodarstwach ze Spisu Rolnego 2020. GUS publikuje użytki rolne, lasy i wody w gminach tylko do 2014 r. Wartości z ewidencji są szacunkiem, bo działka ma listę użytków bez powierzchni każdego z nich. BDOT10k pokazuje pokrycie terenu, nie użytki ewidencyjne."
   },
   "dcat:theme": "Środowisko",
   "dct:temporal": "ewidencja 2026, BDOT10k 2023–2026, spis rolny 2020",
   "dct:accrualPeriodicity": "nieregularnie",
   "dct:modified": {
